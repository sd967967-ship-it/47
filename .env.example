# 47 environment — copy to .47_env (same folder) or export in PowerShell.
# NEVER commit real keys. .47_env is gitignored; prefer env/OS keyring.
#
# PowerShell equivalent:
#   $env:XAI_API_KEY="xai-..."

# xAI Grok brain (https://console.x.ai) — the ONLY cloud LLM 47 uses.
XAI_API_KEY=

# Optional model/safety tuning
GROK_MODEL=grok-3-mini
GROQ_MAX_TOKENS=1000
GROQ_TEMPERATURE=0.4

# Dashboard (all optional)
DASHBOARD_TOKEN=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# Approved file folders (OS path-separator list). Default when unset:
# Documents, Desktop, Downloads, Pictures under your home folder.
47_APPROVED_FOLDERS=

# Extra destructive-command patterns file (default: safety.yaml next door)
47_SAFETY_YAML=

# Voice
WAKE_WORD=hi 47
VOICE_RECOGNIZER=google
JARVIS_VOICE=en-GB-RyanNeural

# Optional: local Home Assistant (your own instance only)
HA_URL=
HA_TOKEN=

# Optional proactive routines (1=on, 0=off)
47_PROACTIVE=1
